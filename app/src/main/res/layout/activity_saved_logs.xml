<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" 
    android:layout_height="match_parent"
    android:orientation="vertical" 
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" 
        android:layout_height="56dp"
        android:orientation="horizontal" 
        android:gravity="center_vertical"
        android:paddingStart="14dp" 
        android:paddingEnd="14dp" 
        android:background="@color/surface">
        
        <LinearLayout android:id="@+id/btn_back" 
            android:layout_width="36dp"
            android:layout_height="36dp" 
            android:background="@drawable/bg_back_btn"
            android:gravity="center" 
            android:layout_marginEnd="12dp">
            <ImageView android:layout_width="18dp" 
                android:layout_height="18dp" 
                android:src="@drawable/ic_back"/>
        </LinearLayout>
        
        <TextView android:layout_width="0dp" 
            android:layout_height="wrap_content"
            android:layout_weight="1" 
            android:text="SAVED LOGS"
            android:textColor="@color/accent" 
            android:textSize="13sp"
            android:textStyle="bold" 
            android:letterSpacing="0.1"/>
    </LinearLayout>
    
    <View android:layout_width="match_parent" 
        android:layout_height="1dp" 
        android:background="@color/border"/>

    <!-- Selection Bar -->
    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="@color/surface"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_close_selection"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_muted"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/tv_selection_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 selected"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>

        <View android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/btn_select_all"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_checkbox_unchecked"
            android:tint="@color/accent"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/btn_export"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_memory"
            android:tint="@color/accent"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <ImageView
            android:id="@+id/btn_delete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_delete"
            android:tint="@color/col_red"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <View android:layout_width="match_parent" 
        android:layout_height="1dp" 
        android:background="@color/border"
        android:id="@+id/selection_divider"/>

    <!-- Empty state -->
    <LinearLayout android:id="@+id/view_empty"
        android:layout_width="match_parent" 
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center" 
        android:visibility="visible"
        android:padding="24dp">
        
        <ImageView
            android:id="@+id/iv_empty_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_logs"
            android:tint="@color/accent"
            android:layout_marginBottom="16dp"
            android:visibility="visible"/>
            
        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content" 
            android:layout_height="wrap_content"
            android:text="NO SAVED LOGS" 
            android:textColor="@color/text_muted"
            android:textSize="16sp" 
            android:letterSpacing="0.1" 
            android:layout_marginBottom="8dp"
            android:textStyle="bold"/>
            
        <TextView
            android:id="@+id/tv_empty_sub"
            android:layout_width="wrap_content" 
            android:layout_height="wrap_content"
            android:text="Logs are saved automatically each day"
            android:textColor="@color/text_muted" 
            android:textSize="13sp"
            android:gravity="center"/>
            
        <Button
            android:id="@+id/btn_go_settings"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="GO TO SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/bg_copy_btn"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView 
        android:id="@+id/rv_saved_logs"
        android:layout_width="match_parent" 
        android:layout_height="match_parent"
        android:padding="10dp"
        android:clipToPadding="false"
        android:visibility="gone"/>

</LinearLayout>