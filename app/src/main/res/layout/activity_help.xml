<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_btn"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_back"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HELP &amp; FAQ"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Quick intro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_preview_box"
                android:padding="14dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Host Master turns your Android device into a local network server. Share files over HTTP or FTP with any device on the same WiFi."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.5"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="FREQUENTLY ASKED" android:textColor="@color/text_muted"
                android:textSize="9sp" android:letterSpacing="0.2" android:layout_marginBottom="8dp"/>

            <!-- FAQ list -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card">

                <!-- FAQ 1 -->
                <LinearLayout
                    android:id="@+id/faq_1_header"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="How do I share files?"
                        android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:tag="arrow"
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:gravity="center" android:text="›"
                        android:textColor="@color/text_muted" android:textSize="18sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/faq_1_body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingBottom="14dp" android:background="@color/surface">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="1. Tap CONFIG on the main screen\n2. Select a folder or files to share\n3. Tap the power button to start the server\n4. Open the URL shown on any device on the same WiFi"
                        android:textColor="@color/text_muted" android:textSize="12sp"
                        android:lineSpacingMultiplier="1.6"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border"/>

                <!-- FAQ 2 -->
                <LinearLayout
                    android:id="@+id/faq_2_header"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="What is HTTP vs FTP?"
                        android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:tag="arrow"
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:gravity="center" android:text="›"
                        android:textColor="@color/text_muted" android:textSize="18sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/faq_2_body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingBottom="14dp" android:background="@color/surface">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="HTTP: Open in any browser. Great for quick file sharing and previewing media.\n\nFTP: Use an FTP client (FileZilla, MT Manager). Better for uploading, downloading, and managing files."
                        android:textColor="@color/text_muted" android:textSize="12sp"
                        android:lineSpacingMultiplier="1.6"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border"/>

                <!-- FAQ 3 -->
                <LinearLayout
                    android:id="@+id/faq_3_header"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Why can't other devices connect?"
                        android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:tag="arrow"
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:gravity="center" android:text="›"
                        android:textColor="@color/text_muted" android:textSize="18sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/faq_3_body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingBottom="14dp" android:background="@color/surface">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="• Make sure both devices are on the same WiFi network\n• Check that the server is running (power button is green)\n• Disable VPN if active\n• Try typing the IP address manually from the server address shown on the main screen"
                        android:textColor="@color/text_muted" android:textSize="12sp"
                        android:lineSpacingMultiplier="1.6"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border"/>

                <!-- FAQ 4 -->
                <LinearLayout
                    android:id="@+id/faq_4_header"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="How to add a password?"
                        android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:tag="arrow"
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:gravity="center" android:text="›"
                        android:textColor="@color/text_muted" android:textSize="18sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/faq_4_body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingBottom="14dp" android:background="@color/surface">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Go to CONFIG → Security section → enter username and password. When connecting, the browser or FTP client will ask for credentials."
                        android:textColor="@color/text_muted" android:textSize="12sp"
                        android:lineSpacingMultiplier="1.6"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border"/>

                <!-- FAQ 5 -->
                <LinearLayout
                    android:id="@+id/faq_5_header"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Some files don't show up — why?"
                        android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <TextView android:tag="arrow"
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:gravity="center" android:text="›"
                        android:textColor="@color/text_muted" android:textSize="18sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/faq_5_body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingBottom="14dp" android:background="@color/surface">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="On Android 11+, apps need 'All Files Access' permission to see all file types (zip, apk, db, etc.).\n\nGo to: Android Settings → Apps → Host Master → Permissions → Files and Media → Allow access to manage all files."
                        android:textColor="@color/text_muted" android:textSize="12sp"
                        android:lineSpacingMultiplier="1.6"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
