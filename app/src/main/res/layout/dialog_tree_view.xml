<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface">

        <TextView
            android:id="@+id/tv_tree_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="File Tree View"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <!-- Fullscreen button (shown in normal dialog) -->
        <ImageView
            android:id="@+id/btn_tree_fullscreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_maximize"
            android:tint="@color/accent"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_icon_btn"
            android:visibility="visible"/>

        <!-- Compress button (shown in fullscreen) -->
        <ImageView
            android:id="@+id/btn_tree_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_compress"
            android:tint="@color/accent"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_icon_btn"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <!-- Horizontal + Vertical scroll for tree content -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <!-- Tree items added programmatically -->
            <LinearLayout
                android:id="@+id/tree_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"/>

        </ScrollView>
    </HorizontalScrollView>
</LinearLayout>
