<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_btn"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_back"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTTP CONFIGURE"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hyper Text Transfer Protocol"
                android:textColor="@color/text_muted"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- HTTP badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_proto_card_selected"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_http"
                android:tint="@color/accent"
                android:layout_marginEnd="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HTTP"
                android:textColor="@color/accent"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="80dp">

            <!-- ══ MODE TOGGLE ════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="4dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/tab_source"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_tab_active"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/img_tab_source_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_folder" 
                        android:tint="@color/accent"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/tab_source_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOST SOURCE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:textColor="@color/accent" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_website"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/img_tab_website_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_globe" 
                        android:tint="@color/text_muted"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/tab_website_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOST WEBSITE"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        android:textColor="@color/text_muted" />

                </LinearLayout>
        
            </LinearLayout>

            <!-- ══ HOST SOURCE SECTION ══ -->
            <LinearLayout
                android:id="@+id/section_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT SOURCE"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:id="@+id/row_select_folder"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_folder" 
                            android:tint="@color/accent"
                            android:layout_marginEnd="14dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Select Folder"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Host an entire folder over the network"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="@color/text_muted"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border"/>

                    <LinearLayout
                        android:id="@+id/row_select_file"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_file" 
                            android:tint="@color/accent"
                            android:layout_marginEnd="14dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Select Files"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pick one or multiple files to share"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="@color/text_muted"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- SOURCE PREVIEW BOX -->
                <LinearLayout
                    android:id="@+id/source_preview_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_preview_box"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SELECTED"
                            android:textColor="@color/accent"
                            android:textSize="9sp"
                            android:letterSpacing="0.2"/>

                        <TextView
                            android:id="@+id/btn_clear_all_source"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CLEAR ALL"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:letterSpacing="0.1"
                            android:paddingStart="8dp"
                            android:paddingEnd="2dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_source_empty_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No folder or files selected yet"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                    <LinearLayout
                        android:id="@+id/source_items_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"/>

                </LinearLayout>

            </LinearLayout>

            <!-- ══ HOST WEBSITE SECTION ══ -->
            <LinearLayout
                android:id="@+id/section_website"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WEB FOLDER"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:letterSpacing="0.2"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/row_open_web_host"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_globe_internet" 
                        android:tint="@color/accent"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage Website Folders"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add folders with index.html to host"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_forward"
                        android:tint="@color/text_muted"/>
                </LinearLayout>

                <!-- WEB PREVIEW BOX -->
                <LinearLayout
                    android:id="@+id/web_preview_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_preview_box"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ACTIVE WEBSITE"
                            android:textColor="@color/accent"
                            android:textSize="9sp"
                            android:letterSpacing="0.2"/>
                        <TextView
                            android:id="@+id/btn_clear_web"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CLEAR"
                            android:textColor="@color/text_muted"
                            android:textSize="9sp"
                            android:paddingStart="8dp"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_web_empty_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No website folder selected yet"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                    <LinearLayout
                        android:id="@+id/web_folder_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/web_folder_chip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_chip_item"
                            android:padding="10dp"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_globe_internet" 
                                android:tint="@color/accent"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="10dp">
                                <TextView
                                    android:id="@+id/tv_web_folder_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:ellipsize="end"/>
                                <TextView
                                    android:id="@+id/tv_web_folder_path"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_muted"
                                    android:textSize="10sp"
                                    android:singleLine="true"
                                    android:ellipsize="start"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btn_remove_web_folder"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:gravity="center"
                                android:text="✕"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp"
                                android:clickable="true"
                                android:focusable="true"
                                android:background="@drawable/bg_icon_btn"
                                android:padding="4dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONTENTS"
                            android:textColor="@color/text_muted"
                            android:textSize="8sp"
                            android:letterSpacing="0.15"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:id="@+id/web_file_tree"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="4dp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ══ SECURITY ══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURITY"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp" 
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lock" 
                        android:tint="@color/accent" 
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Password Protection" 
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Require password to access server"
                            android:textColor="@color/text_muted" android:textSize="11sp"/>
                    </LinearLayout>

                    <Switch android:id="@+id/sw_password"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/auth_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone"
                    android:animateLayoutChanges="true">

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border" android:layout_marginBottom="12dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="USERNAME" android:textColor="@color/text_muted"
                        android:textSize="8sp" android:letterSpacing="0.2" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_username"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:hint="Enter username…" android:inputType="text"
                        android:textSize="13sp" android:textColor="@color/text_primary"
                        android:background="@drawable/bg_input" android:padding="12dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PASSWORD" android:textColor="@color/text_muted"
                        android:textSize="8sp" android:letterSpacing="0.2" android:layout_marginBottom="4dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_input"
                        android:focusable="true"
                        android:focusableInTouchMode="true">
                        <EditText android:id="@+id/et_password"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:hint="Enter password…"
                            android:inputType="textPassword" android:textSize="13sp"
                            android:textColor="@color/text_primary" android:background="@null"
                            android:paddingStart="12dp"/>
                        <ImageView android:id="@+id/btn_toggle_pass_vis"
                            android:layout_width="44dp" android:layout_height="44dp" 
                            android:padding="12dp"
                            android:src="@drawable/ic_visibility_on" 
                            android:gravity="center" 
                            android:tint="@color/accent"
                            android:clickable="true" 
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── QUICK TIPS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_preview_box"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/text_muted"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tip: Enable password protection to secure your HTTP server"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── SAVE BUTTON ─── -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Secure your HTTP server"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.05"/>

        <Button android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="SAVE"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:background="@drawable/bg_copy_btn"
            android:stateListAnimator="@null"/>
    </LinearLayout>

    <!-- Snackbar anchor -->
    <FrameLayout
        android:id="@+id/snackbar_anchor"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

</LinearLayout>