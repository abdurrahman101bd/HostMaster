<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_btn"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_back"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIVACY &amp; DATA"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none" android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- ── DATA SECTION ────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DATA MANAGEMENT"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp" android:letterSpacing="0.2" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card">

                    <!-- Clear Logs -->
                    <LinearLayout
                        android:id="@+id/btn_clear_logs"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:clickable="true" android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_logs"
                            android:tint="@color/accent"
                            android:layout_marginEnd="14dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Clear Logs" android:textColor="@color/text_primary" android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Delete all saved request logs"
                                android:textColor="@color/text_muted" android:textSize="11sp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="@color/text_muted"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border"/>

                    <!-- Reset Stats -->
                    <LinearLayout
                        android:id="@+id/btn_reset_stats"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:clickable="true" android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_analytics"
                            android:tint="@color/accent"
                            android:layout_marginEnd="14dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Reset Statistics" android:textColor="@color/text_primary" android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Reset total requests and data transferred"
                                android:textColor="@color/text_muted" android:textSize="11sp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="@color/text_muted"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── DANGER ZONE ────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="DANGER ZONE"
                    android:textColor="@color/col_red"
                    android:textSize="9sp" android:letterSpacing="0.2" android:layout_marginBottom="8dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card">

                    <!-- Clear All Data -->
                    <LinearLayout
                        android:id="@+id/btn_clear_all"
                        android:layout_width="match_parent" android:layout_height="56dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:clickable="true" android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_delete_forever"
                            android:tint="@color/col_red"
                            android:layout_marginEnd="14dp"/>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Clear All Data" android:textColor="@color/col_red" android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Reset all settings, credentials and paths"
                                android:textColor="@color/text_muted" android:textSize="11sp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_arrow_forward"
                            android:tint="@color/col_red"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── INFO NOTE ───────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_preview_box"
                android:padding="12dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_info"
                    android:tint="@color/text_muted"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Clearing data will not delete files from your storage, only app settings and logs."
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>