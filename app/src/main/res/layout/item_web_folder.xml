<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Section label (PINNED / WEBSITE FOLDERS) -->
    <TextView
        android:id="@+id/tv_section_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WEBSITE FOLDERS"
        android:textColor="@color/text_muted"
        android:textSize="9sp"
        android:letterSpacing="0.2"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"/>

    <!-- Card row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/iv_wf_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_folder"
            android:tint="@color/accent"
            android:contentDescription="folder_icon"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_wf_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tv_wf_active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● ACTIVE"
                    android:textColor="@color/col_green"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:visibility="gone"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_wf_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="start"
                android:layout_marginTop="1dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_wf_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:layout_marginEnd="8dp"/>
           
                <LinearLayout
                    android:id="@+id/index_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:background="@drawable/bg_badge_web">
                    
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_html"
                        android:tint="#E34F26"
                        android:contentDescription="index badge"/>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="index.html"
                        android:textColor="#E34F26"
                        android:textSize="10sp"
                        android:paddingStart="2dp"/>
                </LinearLayout>
                    
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/btn_wf_menu"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_menu_vertical"
            android:padding="10dp"
            android:contentDescription="menu"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </LinearLayout>
</LinearLayout>
