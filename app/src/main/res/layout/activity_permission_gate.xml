<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Permissions Required"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"/>

    <!-- Row: Notification -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Notification"
            android:textColor="@color/text_primary"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/btn_perm_notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Row: Storage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Storage Access"
            android:textColor="@color/text_primary"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/btn_perm_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Row: Battery -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Run in Background"
            android:textColor="@color/text_primary"
            android:textSize="14sp"/>
        <TextView
            android:id="@+id/btn_perm_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"/>
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/btn_gate_start"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="@color/accent"
        android:gravity="center"
        android:text="Start"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:enabled="false"
        android:alpha="0.4"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>