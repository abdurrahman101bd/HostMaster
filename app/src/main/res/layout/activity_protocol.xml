<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_btn"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_back"
                android:tint="@color/accent"/>
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PROTOCOLS"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"/>

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="8dp"
            android:gravity="center_horizontal">

            <!-- HTTP Card -->
            <LinearLayout
                android:id="@+id/card_http"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_proto_card_selected"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal">

                <!-- Big Icon -->
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_http"
                    android:tint="@color/accent"
                    android:layout_marginBottom="8dp"/>

                <!-- Protocol Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HTTP"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <!-- Port -->
                <TextView
                    android:id="@+id/tv_http_port"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PORT 8080"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <!-- Status Dot -->
                <View
                    android:id="@+id/dot_http"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_proto_dot_on"
                    android:layout_marginBottom="12dp"/>

                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HyperText Transfer Protocol — serves files and web pages to browsers. Best for sharing HTML, images, videos, and general file downloads over your local network."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.5"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <!-- Tags -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WEB BROWSER"
                        android:textColor="@color/accent"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FILE SHARE"
                        android:textColor="@color/accent"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NO ENCRYPTION"
                        android:textColor="@color/text_muted"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag_muted"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- FTP Card -->
            <LinearLayout
                android:id="@+id/card_ftp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal">

                <!-- Big Icon -->
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_ftp"
                    android:tint="@color/accent"
                    android:layout_marginBottom="8dp"/>

                <!-- Protocol Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FTP"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <!-- Port -->
                <TextView
                    android:id="@+id/tv_ftp_port"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PORT 2121"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp"/>

                <!-- Status Dot -->
                <View
                    android:id="@+id/dot_ftp"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_proto_dot_off"
                    android:layout_marginBottom="12dp"/>

                <!-- Description -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="File Transfer Protocol — designed for transferring files. Supports upload and download in both directions. Use with FTP clients like Solid Explorer or Total Commander."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.5"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <!-- Tags -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPLOAD + DOWNLOAD"
                        android:textColor="@color/accent"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FTP CLIENT"
                        android:textColor="@color/accent"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FAST TRANSFER"
                        android:textColor="@color/accent"
                        android:textSize="9sp"
                        android:letterSpacing="0.1"
                        android:background="@drawable/bg_tag"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"/>

    <!-- Save Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SAVE SETTINGS"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.1"
            android:textSize="13sp"
            android:background="@drawable/bg_copy_btn"
            android:stateListAnimator="@null"/>
    </LinearLayout>

</LinearLayout>