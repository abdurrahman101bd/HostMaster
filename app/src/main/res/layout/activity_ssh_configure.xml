<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@color/surface">

        <LinearLayout
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_back_btn"
            android:gravity="center"
            android:layout_marginEnd="12dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_back"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SSH CONFIGURE"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Secure Shell / SFTP"
                android:textColor="@color/text_muted"
                android:textSize="10sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐 SSH"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:background="@drawable/bg_proto_card_selected"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/border"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── INFO CARD ─────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_preview_box"
                android:padding="14dp"
                android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ℹ" android:textSize="18sp" android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SSH enables encrypted access. Use SFTP for secure file transfer. Termux integration (coming soon) will allow full terminal access."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>

            <!-- ── SFTP ROOT FOLDER ──────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SFTP ROOT FOLDER"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:id="@+id/row_select_folder"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="📁" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Select SFTP Root Folder"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="SFTP clients will access files from here"
                            android:textColor="@color/text_muted" android:textSize="11sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textColor="@color/text_muted" android:textSize="20sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/path_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_preview_box"
                android:padding="12dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">
                <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                    android:text="📁" android:textSize="16sp"/>
                <TextView
                    android:id="@+id/tv_selected_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="start"/>
                <TextView
                    android:id="@+id/btn_clear_selection"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- ── SERVER SETTINGS ───────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVER SETTINGS"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="10dp">

                <!-- Port -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="🔌" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Port"
                        android:textColor="@color/text_primary" android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/et_port"
                        android:layout_width="80dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/bg_stat_card"
                        android:gravity="center"
                        android:padding="6dp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border"/>

                <!-- SFTP subsystem -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="📂" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Enable SFTP Subsystem"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Allow secure file transfer via SFTP"
                            android:textColor="@color/text_muted" android:textSize="11sp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_sftp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/border"/>

                <!-- Key auth (placeholder) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="🗝" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Key Authentication"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Coming soon — SSH public key login"
                            android:textColor="@color/text_muted" android:textSize="11sp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_key_auth"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track"
                        android:enabled="false" android:alpha="0.5"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── TERMUX INTEGRATION ────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TERMINAL ACCESS"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="💻" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Termux Terminal Access"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Allow terminal commands via SSH (requires Termux)"
                            android:textColor="@color/text_muted" android:textSize="11sp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_termux"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track"/>
                </LinearLayout>

                <!-- Termux note (shown when toggled on) -->
                <LinearLayout
                    android:id="@+id/termux_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_preview_box"
                    android:layout_margin="10dp"
                    android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚠" android:textSize="16sp" android:layout_marginEnd="8dp"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Termux integration is planned for a future release. Install Termux from F-Droid to use this feature once available."
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ── ACCESS CONTROL ────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESS CONTROL"
                android:textColor="@color/text_muted"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                        android:text="🔒" android:textSize="18sp" android:layout_marginEnd="12dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Password Protection"
                            android:textColor="@color/text_primary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Require credentials to connect"
                            android:textColor="@color/text_muted" android:textSize="11sp"/>
                    </LinearLayout>
                    <Switch android:id="@+id/sw_password"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb" android:trackTint="@color/switch_track"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/auth_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/border" android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="USERNAME" android:textColor="@color/text_muted"
                        android:textSize="8sp" android:letterSpacing="0.2" android:layout_marginBottom="4dp"/>
                    <EditText android:id="@+id/et_username"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:hint="Enter username…" android:inputType="text"
                        android:textSize="13sp" android:textColor="@color/text_primary"
                        android:background="@drawable/bg_stat_card" android:padding="10dp"
                        android:layout_marginBottom="10dp"/>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PASSWORD" android:textColor="@color/text_muted"
                        android:textSize="8sp" android:letterSpacing="0.2" android:layout_marginBottom="4dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_stat_card">
                        <EditText android:id="@+id/et_password"
                            android:layout_width="0dp" android:layout_height="match_parent"
                            android:layout_weight="1" android:hint="Enter password…"
                            android:inputType="textPassword" android:textSize="13sp"
                            android:textColor="@color/text_primary" android:background="@null"
                            android:paddingStart="10dp"/>
                        <TextView android:id="@+id/btn_toggle_pass_vis"
                            android:layout_width="44dp" android:layout_height="44dp"
                            android:text="👁" android:textSize="16sp" android:gravity="center"
                            android:clickable="true" android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btn_save"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="SAVE SSH SETTINGS" android:textColor="#FFFFFF"
                android:letterSpacing="0.1" android:textSize="13sp"
                android:background="@drawable/bg_copy_btn"
                android:stateListAnimator="@null" android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
