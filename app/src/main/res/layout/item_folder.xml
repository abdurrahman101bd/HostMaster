<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="14dp" android:background="@color/surface"
    android:layout_marginBottom="2dp">
    <ImageView android:layout_width="28dp" android:layout_height="28dp"
        android:src="@drawable/ic_folder" android:layout_marginEnd="12dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_folder_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:textColor="@color/text_primary" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_folder_count" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:textColor="@color/text_muted"/>
    </LinearLayout>
    <ImageView android:id="@+id/iv_folder_arrow" android:layout_width="32dp"
        android:layout_height="32dp" android:src="@drawable/ic_arrow_right" android:padding="4dp"/>
</LinearLayout>
