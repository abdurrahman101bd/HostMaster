<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_log_item"
    android:layout_marginBottom="4dp">

    <!-- Top row: method + path + status -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingTop="10dp" android:paddingBottom="4dp">

        <TextView android:id="@+id/tv_log_method"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="@color/accent"
            android:textStyle="bold" android:letterSpacing="0.05"
            android:background="@drawable/bg_method_badge"
            android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingTop="2dp" android:paddingBottom="2dp"
            android:layout_marginEnd="8dp"/>

        <TextView android:id="@+id/tv_log_path"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:maxLines="1" android:ellipsize="middle"/>

        <TextView android:id="@+id/tv_log_status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Bottom row: time + client -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView android:id="@+id/tv_log_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textColor="@color/text_muted"
            android:layout_marginEnd="8dp"/>

        <View android:layout_width="1dp" android:layout_height="10dp"
            android:background="@color/border" android:layout_marginEnd="8dp"/>

        <TextView android:id="@+id/tv_log_client"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="10sp"
            android:textColor="@color/text_muted"/>
    </LinearLayout>
</LinearLayout>
